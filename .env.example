# Copy to .env and fill in. docker compose reads this file.

# Webhook secret configured on the GitHub App (docs/GITHUB_APP.md).
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_APP_ID=
# Paste the PEM private key inside double quotes, newlines included.
GITHUB_PRIVATE_KEY=""

ANTHROPIC_API_KEY=

# Claude in Amazon Bedrock instead of the Claude API (README, "Using Amazon Bedrock").
# Any Bedrock model ID works; see the README for which IDs go through Converse.
# LLM_PROVIDER=bedrock
# DEFAULT_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional model overrides (defaults to claude-haiku-4-5 for both agents).
# DEFAULT_MODEL=claude-haiku-4-5
# REVIEW_AGENT_MODEL=claude-sonnet-5-5
# TEST_AGENT_MODEL=

POSTGRES_PASSWORD=prcopilot
